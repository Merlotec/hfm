{
  "_comment": "Fluid Model hyperparameters.",

  "model": {
    "img_size": 256,
    "in_channels": 4,
    "patch_px": 16,

    "d_patch": 384,
    "skip_ch": 32,

    "n_global_tokens": 16,
    "n_heads": 8,

    "noise_std": 0.05,

    "n_layers": 12,
    "mlp_ratio": 4.0,
    "dropout": 0.0,

    "n_context_frames": 5,
    "ctx_patch_px": 16,
    "d_ctx": 384,
    "n_ctx_tokens": 64,
    "n_ctx_layers": 4,
    "n_ctx_heads": 8,

    "disc_dim": 128,
    "disc_adv_weight": 0.1,
    "disc_lr": 1e-4
  },

  "training": {
    "batch_size": 4,
    "n_epochs": 100,

    "lr": 1e-4,
    "weight_decay": 1e-5,
    "clip_grad": 1.0,
    "lr_schedule": "cosine",
    "cosine_t_max": 10000,

    "l1_weight": 0.01,
    "precision": "bf16-true"
  }
}
