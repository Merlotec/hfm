{
  "_comment": "Fluid Model hyperparameters.",

  "model": {
    "img_size": 256,
    "in_channels": 4,
    "patch_px": 16,

    "d_patch": 384,
    "skip_ch": 32,

    "n_global_tokens": 16,
    "n_heads": 8,

    "noise_std": 0.05,

    "n_layers": 12,
    "mlp_ratio": 4.0,
    "dropout": 0.0,

    "n_context_frames": 5,
    "ctx_patch_px": 16,
    "d_ctx": 384,
    "n_ctx_tokens": 64,
    "n_ctx_layers": 4,
    "n_ctx_heads": 8,

    "disc_dim": 128,
    "disc_adv_weight": 0.1,
    "disc_lr": 1e-4
  },

  "training": {
    "_sizing": "Dawn PVC 1550, 1 node x 8 tiles (ZE_FLAT), ~64GB HBM/tile. batch_size is PER RANK: effective batch = 32 x 8 = 256. lr ~sqrt-scaled from 1e-4@bs4. cosine_t_max ~= total optimizer steps: 100 epochs x ceil(17976/(32*8)) ~= 7100. num_workers per rank (12 cpus/task).",
    "batch_size": 32,
    "n_epochs": 100,
    "num_workers": 8,

    "lr": 4e-4,
    "weight_decay": 1e-5,
    "clip_grad": 1.0,
    "lr_schedule": "cosine",
    "cosine_t_max": 7000,

    "l1_weight": 0.01,
    "precision": "bf16-true"
  }
}
