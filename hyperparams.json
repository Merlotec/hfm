{
  "_comment": "Hierarchical Fluid Model hyperparameters. Tuple fields use arrays.",

  "model": {
    "img_size": 256,
    "in_channels": 4,
    "patch_px": 4,

    "d_patch": 64,
    "d_resid": 64,

    "feat_sizes": [32, 64, 128, 256],
    "d_feat":     [512, 256, 128, 64],
    "d_sys":      [256, 128,  64, 32],

    "patch_local_radius": 3,
    "feat_window_size": 8,
    "n_heads_patch": 4,
    "n_heads_feat": [8, 4, 2, 1],
    "n_heads_sys":  [4, 2, 1, 1],
    "n_heads_resid": 4,

    "n_layers": 6,
    "mlp_ratio": 4.0,
    "dropout": 0.0
  },

  "training": {
    "n_warmup_frames": 5,
    "batch_size": 4,
    "n_epochs": 100,
    "frames_per_step": 7,

    "lr": 1e-4,
    "weight_decay": 1e-5,
    "clip_grad": 1.0,
    "lr_schedule": "cosine",
    "lr_warmup_steps": 1000,
    "cosine_t_max": 10000,

    "l1_weight": 0.1
  }
}
