{
  "_comment": "Hierarchical Fluid Model hyperparameters. Tuple fields use arrays.",

  "model": {
    "img_size": 256,
    "in_channels": 4,
    "patch_px": 4,

    "d_patch": 64,

    "feat_sizes": [32, 64, 128, 256],
    "d_feat":     [512, 256, 128, 64],

    "patch_local_radius": 3,
    "feat_window_size": 8,
    "n_heads_patch": 4,
    "n_heads_feat": [8, 4, 2, 1],

    "n_layers": 8,
    "mlp_ratio": 4.0,
    "dropout": 0.0,
    "n_coarse_levels": 2,
    "n_fine_layers": 2,

    "n_context_frames": 5,
    "ctx_patch_px": 16,
    "d_ctx": 256,
    "n_ctx_tokens": 64,
    "n_ctx_layers": 4,
    "n_ctx_heads": 8,

    "disc_dim": 128,
    "disc_adv_weight": 0.02,
    "disc_lr": 1e-4
  },

  "training": {
    "batch_size": 4,
    "n_epochs": 100,

    "lr": 1e-4,
    "weight_decay": 1e-5,
    "clip_grad": 1.0,
    "lr_schedule": "cosine",
    "cosine_t_max": 10000,

    "l1_weight": 0.1
  }
}
